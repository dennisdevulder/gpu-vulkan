#version 450

layout(local_size_x = 64) in;

struct ModelInstance
{
	uint meshOffsetLo;
	uint meshOffsetHi;
	int meshBytes;
	int faceCount;
	int vertexCount;
	int orient;
	int worldX;
	int worldY;
	int worldZ;
	int renderMode;
};

layout(set = 0, binding = 0, std430) readonly buffer ModelMeshData
{
	uint meshWords[];
};

layout(set = 0, binding = 1, std430) readonly buffer ModelInstances
{
	ModelInstance instances[];
};

layout(set = 0, binding = 2, std430) writeonly buffer GeneratedVertices
{
	uint vertexWords[];
};

layout(push_constant) uniform Push
{
	uint instanceCount;
} pc;

void main()
{
	uint instanceId = gl_GlobalInvocationID.x;
	if (instanceId >= pc.instanceCount)
	{
		return;
	}

	ModelInstance instance = instances[instanceId];
	if (instance.faceCount <= 0 || instance.meshBytes <= 0)
	{
		return;
	}

	// First-stage prototype: validate GPU-side access to the passive mesh and
	// instance streams. Actual vertex emission is added once this path is live.
	uint meshWord = meshWords[instance.meshOffsetLo >> 2];
	if (meshWord == 0xffffffffu)
	{
		return;
	}

	uint vertexBase = instanceId * 12u;
	vertexWords[vertexBase + 0u] = floatBitsToUint(float(instance.worldX));
	vertexWords[vertexBase + 1u] = floatBitsToUint(float(instance.worldY));
	vertexWords[vertexBase + 2u] = floatBitsToUint(float(instance.worldZ));
	vertexWords[vertexBase + 3u] = 0u;
	vertexWords[vertexBase + 4u] = meshWord;
	vertexWords[vertexBase + 5u] = uint(instance.faceCount);
	vertexWords[vertexBase + 6u] = uint(instance.vertexCount);
	vertexWords[vertexBase + 7u] = 0u;
	vertexWords[vertexBase + 8u] = 0u;
	vertexWords[vertexBase + 9u] = 0u;
	vertexWords[vertexBase + 10u] = 0u;
	vertexWords[vertexBase + 11u] = 0u;
}
