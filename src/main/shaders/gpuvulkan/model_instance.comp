#version 450

layout(local_size_x = 64) in;

struct ModelInstance
{
	uint meshOffsetLo;
	uint meshOffsetHi;
	int meshBytes;
	int faceCount;
	int vertexCount;
	int orient;
	int worldX;
	int worldY;
	int worldZ;
	int renderMode;
	int outputFaceOffset;
	int outputFaceCount;
	int flags;
	int faceIndexOffset;
};

layout(set = 0, binding = 0, std430) readonly buffer ModelMeshData
{
	uint meshWords[];
};

layout(set = 0, binding = 1, std430) readonly buffer ModelInstances
{
	ModelInstance instances[];
};

layout(set = 0, binding = 2, std430) writeonly buffer GeneratedVertices
{
	uint vertexWords[];
};

layout(set = 0, binding = 3, std430) readonly buffer SortedFaceIndices
{
	int faceIndices[];
};

layout(push_constant) uniform Push
{
	uint instanceCount;
	uint faceSlotsPerInstance;
	uint debugVisual;
} pc;

const float PI2_OVER_2048 = 0.0030679615757712823;
const uint HEADER_VERTICES_X = 0u;
const uint HEADER_VERTICES_Y = 1u;
const uint HEADER_VERTICES_Z = 2u;
const uint HEADER_FACE_A = 3u;
const uint HEADER_FACE_B = 4u;
const uint HEADER_FACE_C = 5u;
const uint HEADER_COLOR_A = 6u;
const uint HEADER_COLOR_B = 7u;
const uint HEADER_COLOR_C = 8u;
const uint HEADER_FACE_TEXTURE = 9u;
const uint HEADER_TRANSPARENCY = 10u;
const uint HEADER_BIAS = 11u;
const uint HEADER_TEXTURE_FACE = 12u;
const uint HEADER_TEX_A = 13u;
const uint HEADER_TEX_B = 14u;
const uint HEADER_TEX_C = 15u;
const int MODEL_FLAG_HAS_TEXTURES = 1;
const int MODEL_FLAG_HAS_TEXTURE_MAPPING = 2;

float readFloat(uint meshBaseWord, uint offsetBytes, uint index)
{
	return uintBitsToFloat(meshWords[meshBaseWord + (offsetBytes >> 2) + index]);
}

int readInt(uint meshBaseWord, uint offsetBytes, uint index)
{
	return int(meshWords[meshBaseWord + (offsetBytes >> 2) + index]);
}

int readByte(uint meshBaseWord, uint offsetBytes, uint index)
{
	uint byteOffset = offsetBytes + index;
	uint word = meshWords[meshBaseWord + (byteOffset >> 2)];
	uint shift = (byteOffset & 3u) * 8u;
	return int((word >> shift) & 0xffu);
}

int readShort(uint meshBaseWord, uint offsetBytes, uint index)
{
	uint byteOffset = offsetBytes + index * 2u;
	uint word = meshWords[meshBaseWord + (byteOffset >> 2)];
	uint shift = (byteOffset & 2u) * 8u;
	int value = int((word >> shift) & 0xffffu);
	return value >= 32768 ? value - 65536 : value;
}

void writeVertex(uint vertexWordBase, vec3 position, vec3 color, float light, vec2 uv, uint texLayer)
{
	vertexWords[vertexWordBase + 0u] = floatBitsToUint(position.x);
	vertexWords[vertexWordBase + 1u] = floatBitsToUint(position.y);
	vertexWords[vertexWordBase + 2u] = floatBitsToUint(position.z);
	vertexWords[vertexWordBase + 3u] = 0u;
	vertexWords[vertexWordBase + 4u] = floatBitsToUint(color.x);
	vertexWords[vertexWordBase + 5u] = floatBitsToUint(color.y);
	vertexWords[vertexWordBase + 6u] = floatBitsToUint(color.z);
	vertexWords[vertexWordBase + 7u] = 0u;
	vertexWords[vertexWordBase + 8u] = floatBitsToUint(light);
	vertexWords[vertexWordBase + 9u] = floatBitsToUint(uv.x);
	vertexWords[vertexWordBase + 10u] = floatBitsToUint(uv.y);
	vertexWords[vertexWordBase + 11u] = texLayer;
}

void writeDegenerateFace(uint vertexWordBase)
{
	vec3 zero = vec3(0.0);
	writeVertex(vertexWordBase, zero, zero, 0.0, vec2(0.0), 0u);
	writeVertex(vertexWordBase + 12u, zero, zero, 0.0, vec2(0.0), 0u);
	writeVertex(vertexWordBase + 24u, zero, zero, 0.0, vec2(0.0), 0u);
}

vec3 transformVertex(float localX, float localY, float localZ, float orient, vec3 world)
{
	float angle = orient * PI2_OVER_2048;
	float s = sin(angle);
	float c = cos(angle);
	float x = localZ * s + localX * c;
	float z = localZ * c - localX * s;
	return vec3(x + world.x, localY + world.y, z + world.z);
}

vec3 hslToRgb(int hsl)
{
	int hue = (hsl >> 10) & 0x3f;
	int sat = (hsl >> 7) & 0x07;
	int lum = hsl & 0x7f;
	float h = float(hue) / 64.0 + 0.0078125;
	float s = float(sat) / 8.0 + 0.0625;
	float l = float(lum) / 128.0;
	float q = (l < 0.5) ? l * (1.0 + s) : l + s - l * s;
	float p = 2.0 * l - q;
	vec3 t = vec3(h + 1.0 / 3.0, h, h - 1.0 / 3.0);
	t = mix(t, t + 1.0, lessThan(t, vec3(0.0)));
	t = mix(t, t - 1.0, greaterThan(t, vec3(1.0)));
	vec3 rgb = mix(vec3(p), vec3(q), step(t, vec3(0.5)));
	rgb = mix(rgb, p + (q - p) * (2.0 / 3.0 - t) * 6.0, step(t, vec3(2.0 / 3.0)));
	rgb = mix(rgb, p + (q - p) * 6.0 * t, step(t, vec3(1.0 / 6.0)));
	return rgb;
}

void computeFaceUvs(out vec2 uvA, out vec2 uvB, out vec2 uvC,
	uint meshBaseWord, uint verticesXOffset, uint verticesYOffset, uint verticesZOffset,
	uint textureFacesOffset, uint texAOffset, uint texBOffset, uint texCOffset,
	uint faceSlot, uint ia, uint ib, uint ic)
{
	int tfaceIdx = readByte(meshBaseWord, textureFacesOffset, faceSlot);
	if (tfaceIdx == 255)
	{
		uvA = vec2(0.0, 0.0);
		uvB = vec2(1.0, 0.0);
		uvC = vec2(0.0, 1.0);
		return;
	}

	uint texA = uint(readInt(meshBaseWord, texAOffset, uint(tfaceIdx)));
	uint texB = uint(readInt(meshBaseWord, texBOffset, uint(tfaceIdx)));
	uint texC = uint(readInt(meshBaseWord, texCOffset, uint(tfaceIdx)));

	vec3 v1 = vec3(
		readFloat(meshBaseWord, verticesXOffset, texA),
		readFloat(meshBaseWord, verticesYOffset, texA),
		readFloat(meshBaseWord, verticesZOffset, texA));
	vec3 v2 = vec3(
		readFloat(meshBaseWord, verticesXOffset, texB),
		readFloat(meshBaseWord, verticesYOffset, texB),
		readFloat(meshBaseWord, verticesZOffset, texB)) - v1;
	vec3 v3 = vec3(
		readFloat(meshBaseWord, verticesXOffset, texC),
		readFloat(meshBaseWord, verticesYOffset, texC),
		readFloat(meshBaseWord, verticesZOffset, texC)) - v1;
	vec3 v4 = vec3(
		readFloat(meshBaseWord, verticesXOffset, ia),
		readFloat(meshBaseWord, verticesYOffset, ia),
		readFloat(meshBaseWord, verticesZOffset, ia)) - v1;
	vec3 v5 = vec3(
		readFloat(meshBaseWord, verticesXOffset, ib),
		readFloat(meshBaseWord, verticesYOffset, ib),
		readFloat(meshBaseWord, verticesZOffset, ib)) - v1;
	vec3 v6 = vec3(
		readFloat(meshBaseWord, verticesXOffset, ic),
		readFloat(meshBaseWord, verticesYOffset, ic),
		readFloat(meshBaseWord, verticesZOffset, ic)) - v1;

	vec3 v7 = cross(v2, v3);
	vec3 v8 = cross(v3, v7);
	float f = 1.0 / dot(v8, v2);
	uvA.x = dot(v8, v4) * f;
	uvB.x = dot(v8, v5) * f;
	uvC.x = dot(v8, v6) * f;

	v8 = cross(v2, v7);
	f = 1.0 / dot(v8, v3);
	uvA.y = dot(v8, v4) * f;
	uvB.y = dot(v8, v5) * f;
	uvC.y = dot(v8, v6) * f;
}

void main()
{
	uint faceSlot = gl_GlobalInvocationID.x;
	uint instanceId = gl_GlobalInvocationID.y;
	if (instanceId >= pc.instanceCount)
	{
		return;
	}

	ModelInstance instance = instances[instanceId];
	if (instance.faceCount <= 0 || instance.meshBytes <= 0)
	{
		return;
	}
	if (faceSlot >= uint(instance.outputFaceCount) || faceSlot >= pc.faceSlotsPerInstance)
	{
		return;
	}
	uint vertexBase = (uint(instance.outputFaceOffset) + faceSlot) * 36u;
	uint faceIndex = instance.faceIndexOffset >= 0
		? uint(faceIndices[uint(instance.faceIndexOffset) + faceSlot])
		: faceSlot;

	uint meshBaseWord = instance.meshOffsetLo >> 2;
	uint verticesXOffset = meshWords[meshBaseWord + HEADER_VERTICES_X];
	uint verticesYOffset = meshWords[meshBaseWord + HEADER_VERTICES_Y];
	uint verticesZOffset = meshWords[meshBaseWord + HEADER_VERTICES_Z];
	uint faceAOffset = meshWords[meshBaseWord + HEADER_FACE_A];
	uint faceBOffset = meshWords[meshBaseWord + HEADER_FACE_B];
	uint faceCOffset = meshWords[meshBaseWord + HEADER_FACE_C];
	uint colorAOffset = meshWords[meshBaseWord + HEADER_COLOR_A];
	uint colorBOffset = meshWords[meshBaseWord + HEADER_COLOR_B];
	uint colorCOffset = meshWords[meshBaseWord + HEADER_COLOR_C];
	uint faceTextureOffset = meshWords[meshBaseWord + HEADER_FACE_TEXTURE];
	uint transparencyOffset = meshWords[meshBaseWord + HEADER_TRANSPARENCY];
	uint biasOffset = meshWords[meshBaseWord + HEADER_BIAS];
	uint textureFacesOffset = meshWords[meshBaseWord + HEADER_TEXTURE_FACE];
	uint texAOffset = meshWords[meshBaseWord + HEADER_TEX_A];
	uint texBOffset = meshWords[meshBaseWord + HEADER_TEX_B];
	uint texCOffset = meshWords[meshBaseWord + HEADER_TEX_C];

	if (faceIndex >= uint(instance.faceCount))
	{
		return;
	}

	int ia = readInt(meshBaseWord, faceAOffset, faceIndex);
	int ib = readInt(meshBaseWord, faceBOffset, faceIndex);
	int ic = readInt(meshBaseWord, faceCOffset, faceIndex);
	int colorA = readInt(meshBaseWord, colorAOffset, faceIndex);
	int colorB = readInt(meshBaseWord, colorBOffset, faceIndex);
	int colorC = readInt(meshBaseWord, colorCOffset, faceIndex);
	uint trans = uint(readByte(meshBaseWord, transparencyOffset, faceIndex));
	uint bias = uint(readByte(meshBaseWord, biasOffset, faceIndex));
	if (ia < 0 || ib < 0 || ic < 0)
	{
		writeDegenerateFace(vertexBase);
		return;
	}
	if (colorC == -2)
	{
		writeDegenerateFace(vertexBase);
		return;
	}
	if (colorC == -1)
	{
		colorB = colorA;
		colorC = colorA;
	}

	vec3 world = vec3(float(instance.worldX), float(instance.worldY), float(instance.worldZ));
	uint uia = uint(ia);
	uint uib = uint(ib);
	uint uic = uint(ic);
	vec3 a = transformVertex(
		readFloat(meshBaseWord, verticesXOffset, uia),
		readFloat(meshBaseWord, verticesYOffset, uia),
		readFloat(meshBaseWord, verticesZOffset, uia),
		float(instance.orient),
		world);
	vec3 b = transformVertex(
		readFloat(meshBaseWord, verticesXOffset, uib),
		readFloat(meshBaseWord, verticesYOffset, uib),
		readFloat(meshBaseWord, verticesZOffset, uib),
		float(instance.orient),
		world);
	vec3 c = transformVertex(
		readFloat(meshBaseWord, verticesXOffset, uic),
		readFloat(meshBaseWord, verticesYOffset, uic),
		readFloat(meshBaseWord, verticesZOffset, uic),
		float(instance.orient),
		world);

	vec2 uvA = vec2(0.0, 0.0);
	vec2 uvB = vec2(0.0, 0.0);
	vec2 uvC = vec2(0.0, 0.0);
	uint texLayer = 0u;
	if ((instance.flags & MODEL_FLAG_HAS_TEXTURES) != 0)
	{
		int faceTexture = readShort(meshBaseWord, faceTextureOffset, faceIndex);
		if (faceTexture != -1)
		{
			texLayer = uint(faceTexture + 1);
			if ((instance.flags & MODEL_FLAG_HAS_TEXTURE_MAPPING) != 0)
			{
				computeFaceUvs(uvA, uvB, uvC,
					meshBaseWord, verticesXOffset, verticesYOffset, verticesZOffset,
					textureFacesOffset, texAOffset, texBOffset, texCOffset,
					faceIndex, uia, uib, uic);
			}
			else
			{
				uvB = vec2(1.0, 0.0);
				uvC = vec2(0.0, 1.0);
			}
		}
	}
	uint packedTexLayer = texLayer | (bias << 16u) | (trans << 24u);
	if (pc.debugVisual != 0u)
	{
		vec3 lifted = vec3(0.0, 24.0, 0.0);
		vec3 debugGreen = vec3(0.0, 1.0, 0.0);
		writeVertex(vertexBase, a + lifted, debugGreen, 65535.0, uvA, packedTexLayer);
		writeVertex(vertexBase + 12u, b + lifted, debugGreen, 65535.0, uvB, packedTexLayer);
		writeVertex(vertexBase + 24u, c + lifted, debugGreen, 65535.0, uvC, packedTexLayer);
		return;
	}

	writeVertex(vertexBase, a, hslToRgb(colorA & 0xffff), float(colorA & 0xffff), uvA, packedTexLayer);
	writeVertex(vertexBase + 12u, b, hslToRgb(colorB & 0xffff), float(colorB & 0xffff), uvB, packedTexLayer);
	writeVertex(vertexBase + 24u, c, hslToRgb(colorC & 0xffff), float(colorC & 0xffff), uvC, packedTexLayer);
}
