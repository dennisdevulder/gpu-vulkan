#version 450

layout(local_size_x = 64) in;

struct ModelInstance
{
	uint meshOffsetLo;
	uint meshOffsetHi;
	int meshBytes;
	int faceCount;
	int vertexCount;
	int orient;
	int worldX;
	int worldY;
	int worldZ;
	int renderMode;
	int outputFaceOffset;
	int outputFaceCount;
};

layout(set = 0, binding = 0, std430) readonly buffer ModelMeshData
{
	uint meshWords[];
};

layout(set = 0, binding = 1, std430) readonly buffer ModelInstances
{
	ModelInstance instances[];
};

layout(set = 0, binding = 2, std430) writeonly buffer GeneratedVertices
{
	uint vertexWords[];
};

layout(push_constant) uniform Push
{
	uint instanceCount;
	uint faceSlotsPerInstance;
	uint debugVisual;
} pc;

const float PI2_OVER_2048 = 0.0030679615757712823;
const uint HEADER_VERTICES_X = 0u;
const uint HEADER_VERTICES_Y = 1u;
const uint HEADER_VERTICES_Z = 2u;
const uint HEADER_FACE_A = 3u;
const uint HEADER_FACE_B = 4u;
const uint HEADER_FACE_C = 5u;
const uint HEADER_COLOR_A = 6u;
const uint HEADER_COLOR_B = 7u;
const uint HEADER_COLOR_C = 8u;
const uint HEADER_TRANSPARENCY = 10u;
const uint HEADER_BIAS = 11u;

float readFloat(uint meshBaseWord, uint offsetBytes, uint index)
{
	return uintBitsToFloat(meshWords[meshBaseWord + (offsetBytes >> 2) + index]);
}

int readInt(uint meshBaseWord, uint offsetBytes, uint index)
{
	return int(meshWords[meshBaseWord + (offsetBytes >> 2) + index]);
}

int readByte(uint meshBaseWord, uint offsetBytes, uint index)
{
	uint byteOffset = offsetBytes + index;
	uint word = meshWords[meshBaseWord + (byteOffset >> 2)];
	uint shift = (byteOffset & 3u) * 8u;
	return int((word >> shift) & 0xffu);
}

void writeVertex(uint vertexWordBase, vec3 position, vec3 color, float light, uint texLayer)
{
	vertexWords[vertexWordBase + 0u] = floatBitsToUint(position.x);
	vertexWords[vertexWordBase + 1u] = floatBitsToUint(position.y);
	vertexWords[vertexWordBase + 2u] = floatBitsToUint(position.z);
	vertexWords[vertexWordBase + 3u] = 0u;
	vertexWords[vertexWordBase + 4u] = floatBitsToUint(color.x);
	vertexWords[vertexWordBase + 5u] = floatBitsToUint(color.y);
	vertexWords[vertexWordBase + 6u] = floatBitsToUint(color.z);
	vertexWords[vertexWordBase + 7u] = 0u;
	vertexWords[vertexWordBase + 8u] = floatBitsToUint(light);
	vertexWords[vertexWordBase + 9u] = 0u;
	vertexWords[vertexWordBase + 10u] = 0u;
	vertexWords[vertexWordBase + 11u] = texLayer;
}

void writeDegenerateFace(uint vertexWordBase)
{
	vec3 zero = vec3(0.0);
	writeVertex(vertexWordBase, zero, zero, 0.0, 0u);
	writeVertex(vertexWordBase + 12u, zero, zero, 0.0, 0u);
	writeVertex(vertexWordBase + 24u, zero, zero, 0.0, 0u);
}

vec3 transformVertex(float localX, float localY, float localZ, float orient, vec3 world)
{
	float angle = orient * PI2_OVER_2048;
	float s = sin(angle);
	float c = cos(angle);
	float x = localZ * s + localX * c;
	float z = localZ * c - localX * s;
	return vec3(x + world.x, localY + world.y, z + world.z);
}

vec3 hslToRgb(int hsl)
{
	int hue = (hsl >> 10) & 0x3f;
	int sat = (hsl >> 7) & 0x07;
	int lum = hsl & 0x7f;
	float h = float(hue) / 64.0 + 0.0078125;
	float s = float(sat) / 8.0 + 0.0625;
	float l = float(lum) / 128.0;
	float q = (l < 0.5) ? l * (1.0 + s) : l + s - l * s;
	float p = 2.0 * l - q;
	vec3 t = vec3(h + 1.0 / 3.0, h, h - 1.0 / 3.0);
	t = mix(t, t + 1.0, lessThan(t, vec3(0.0)));
	t = mix(t, t - 1.0, greaterThan(t, vec3(1.0)));
	vec3 rgb = mix(vec3(p), vec3(q), step(t, vec3(0.5)));
	rgb = mix(rgb, p + (q - p) * (2.0 / 3.0 - t) * 6.0, step(t, vec3(2.0 / 3.0)));
	rgb = mix(rgb, p + (q - p) * 6.0 * t, step(t, vec3(1.0 / 6.0)));
	return rgb;
}

void main()
{
	uint faceSlot = gl_GlobalInvocationID.x;
	uint instanceId = gl_GlobalInvocationID.y;
	if (instanceId >= pc.instanceCount)
	{
		return;
	}

	ModelInstance instance = instances[instanceId];
	if (instance.faceCount <= 0 || instance.meshBytes <= 0)
	{
		return;
	}
	if (faceSlot >= uint(instance.outputFaceCount) || faceSlot >= pc.faceSlotsPerInstance)
	{
		return;
	}
	uint vertexBase = (uint(instance.outputFaceOffset) + faceSlot) * 36u;

	uint meshBaseWord = instance.meshOffsetLo >> 2;
	uint verticesXOffset = meshWords[meshBaseWord + HEADER_VERTICES_X];
	uint verticesYOffset = meshWords[meshBaseWord + HEADER_VERTICES_Y];
	uint verticesZOffset = meshWords[meshBaseWord + HEADER_VERTICES_Z];
	uint faceAOffset = meshWords[meshBaseWord + HEADER_FACE_A];
	uint faceBOffset = meshWords[meshBaseWord + HEADER_FACE_B];
	uint faceCOffset = meshWords[meshBaseWord + HEADER_FACE_C];
	uint colorAOffset = meshWords[meshBaseWord + HEADER_COLOR_A];
	uint colorBOffset = meshWords[meshBaseWord + HEADER_COLOR_B];
	uint colorCOffset = meshWords[meshBaseWord + HEADER_COLOR_C];
	uint transparencyOffset = meshWords[meshBaseWord + HEADER_TRANSPARENCY];
	uint biasOffset = meshWords[meshBaseWord + HEADER_BIAS];

	if (faceSlot >= uint(instance.faceCount))
	{
		return;
	}

	int ia = readInt(meshBaseWord, faceAOffset, faceSlot);
	int ib = readInt(meshBaseWord, faceBOffset, faceSlot);
	int ic = readInt(meshBaseWord, faceCOffset, faceSlot);
	int colorA = readInt(meshBaseWord, colorAOffset, faceSlot);
	int colorB = readInt(meshBaseWord, colorBOffset, faceSlot);
	int colorC = readInt(meshBaseWord, colorCOffset, faceSlot);
	uint trans = uint(readByte(meshBaseWord, transparencyOffset, faceSlot));
	uint bias = uint(readByte(meshBaseWord, biasOffset, faceSlot));
	if (ia < 0 || ib < 0 || ic < 0)
	{
		writeDegenerateFace(vertexBase);
		return;
	}
	if (colorC == -2)
	{
		writeDegenerateFace(vertexBase);
		return;
	}
	if (colorC == -1)
	{
		colorB = colorA;
		colorC = colorA;
	}

	vec3 world = vec3(float(instance.worldX), float(instance.worldY), float(instance.worldZ));
	vec3 a = transformVertex(
		readFloat(meshBaseWord, verticesXOffset, uint(ia)),
		readFloat(meshBaseWord, verticesYOffset, uint(ia)),
		readFloat(meshBaseWord, verticesZOffset, uint(ia)),
		float(instance.orient),
		world);
	vec3 b = transformVertex(
		readFloat(meshBaseWord, verticesXOffset, uint(ib)),
		readFloat(meshBaseWord, verticesYOffset, uint(ib)),
		readFloat(meshBaseWord, verticesZOffset, uint(ib)),
		float(instance.orient),
		world);
	vec3 c = transformVertex(
		readFloat(meshBaseWord, verticesXOffset, uint(ic)),
		readFloat(meshBaseWord, verticesYOffset, uint(ic)),
		readFloat(meshBaseWord, verticesZOffset, uint(ic)),
		float(instance.orient),
		world);

	uint packedTexLayer = (bias << 16u) | (trans << 24u);
	if (pc.debugVisual != 0u)
	{
		vec3 lifted = vec3(0.0, 24.0, 0.0);
		vec3 debugGreen = vec3(0.0, 1.0, 0.0);
		writeVertex(vertexBase, a + lifted, debugGreen, 65535.0, packedTexLayer);
		writeVertex(vertexBase + 12u, b + lifted, debugGreen, 65535.0, packedTexLayer);
		writeVertex(vertexBase + 24u, c + lifted, debugGreen, 65535.0, packedTexLayer);
		return;
	}

	writeVertex(vertexBase, a, hslToRgb(colorA & 0xffff), float(colorA & 0xffff), packedTexLayer);
	writeVertex(vertexBase + 12u, b, hslToRgb(colorB & 0xffff), float(colorB & 0xffff), packedTexLayer);
	writeVertex(vertexBase + 24u, c, hslToRgb(colorC & 0xffff), float(colorC & 0xffff), packedTexLayer);
}
